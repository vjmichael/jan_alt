{
  "productName": "Lu",
  "mainBinaryName": "Lu-Desktop",
  "identifier": "ai.lu.preview",
  "build": {
    "beforeDevCommand": "cross-env IS_TAURI=true IS_DEV=true LU_BRAND=true yarn dev:web",
    "beforeBuildCommand": "cross-env IS_TAURI=true LU_BRAND=true yarn build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lu (Development Preview)",
        "width": 1200,
        "minWidth": 1024,
        "height": 800,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": false,
        "center": true,
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 32
        },
        "decorations": false,
        "titleBarStyle": "Overlay",
        "windowEffects": {
          "effects": [
            "fullScreenUI",
            "mica",
            "tabbed",
            "blur",
            "acrylic"
          ],
          "state": "active"
        },
        "dragDropEnabled": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  },
  "bundle": {
    "publisher": "Lu Development Preview",
    "icon": [
      "icons/lu/32x32.png",
      "icons/lu/128x128.png",
      "icons/lu/128x128@2x.png",
      "icons/lu/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "resources": {
      "resources/lu-inference/": "lu-inference/"
    }
  }
}
