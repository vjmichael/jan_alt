+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn tmp() -> std::path::PathBuf {
+        let dir = std::env::temp_dir().join(format!(
+            "lu-d03-approval-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        fs::create_dir(&dir).unwrap();
+        fs::set_permissions(&dir, fs::Permissions::from_mode(0o700)).unwrap();
+        dir
+    }
+    const HASH: &str = "f547294522d0b4416bdce76010ca273571ff4820f53f2e2d377ca1fcb1f9c507";
+    #[test]
+    fn one_shot_exact_turn_no_replay_or_cross_turn() {
+        let dir = tmp();
+        let mut s = DevApprovalStore::open(&dir).unwrap();
+        assert!(!s.consume("nonce-a", "chat-a", "user-a", HASH).unwrap());
+        s.issue("nonce-a", "chat-a", "user-a", HASH).unwrap();
+        assert!(!s.consume("nonce-a", "chat-b", "user-a", HASH).unwrap());
+        assert!(!s.consume("nonce-a", "chat-a", "user-b", HASH).unwrap());
+        assert!(!s
+            .consume("nonce-a", "chat-a", "user-a", &"1".repeat(64))
+            .unwrap());
+        assert!(s.consume("nonce-a", "chat-a", "user-a", HASH).unwrap());
+        assert!(!s.consume("nonce-a", "chat-a", "user-a", HASH).unwrap());
+        assert!(s.issue("nonce-a", "chat-a", "user-a", HASH).is_err());
+        drop(s);
+        let mut reopened = DevApprovalStore::open(&dir).unwrap();
+        assert!(!reopened
+            .consume("nonce-a", "chat-a", "user-a", HASH)
+            .unwrap());
+        drop(reopened);
+        fs::remove_dir_all(dir).unwrap();
+    }
+    #[test]
+    fn expired_approval_denied_and_symlink_rejected() {
+        let dir = tmp();
+        let mut s = DevApprovalStore::open(&dir).unwrap();
+        s.issue("nonce-a", "chat-a", "user-a", HASH).unwrap();
+        s.conn
+            .execute("UPDATE approvals SET approved_at=1", [])
+            .unwrap();
+        assert!(!s.consume("nonce-a", "chat-a", "user-a", HASH).unwrap());
+        drop(s);
+        fs::remove_dir_all(dir).unwrap();
+        let dir = tmp();
+        std::os::unix::fs::symlink("/tmp/nonexistent", dir.join(FILE)).unwrap();
+        assert!(DevApprovalStore::open(&dir).is_err());
+        fs::remove_dir_all(dir).unwrap();
+    }
+}
