+//! D03 laboratory-only model-facing Cognitum rational capability.
+//!
+//! Its effect is ExecuteCode because it launches fixed Python; a model schema
+//! or public name is never an authorization. Registration requires a separately
+//! attested, one-shot developer operator approval for a persisted USER turn.
+//! No generic CE admission, no kernel confinement and no MCP transport.
+use crate::{
+    cognitum_dev_native::{capability, CognitumDeveloperWorker},
+    contracts::{
+        ModuleKind, ModuleManifest, NativeTool, ProtoPayload, ToolDescriptor, ToolEffect,
+        ToolFailure, ToolFuture, ToolInvocation, ToolOutput, CORE_CONTRACT_VERSION,
+    },
+    inference_host::Cancellation,
+    model::{expect_fields, ModelToolCatalog, ModelToolCodec, ModelToolDefinition, ModelToolError},
+    registry::NativeToolRegistry,
+};
+use prost::Message;
+use serde_json::{json, Map, Value};
+use std::{path::Path, sync::Arc};
+
+pub const ID: &str = "lu.cognitum.dev_rational";
+pub const MODEL_NAME: &str = "lu_cognitum_rational";
+const INPUT: &str = "type.googleapis.com/cognitum.v1.CalculateRationalRequest";
+const OUTPUT: &str = "type.googleapis.com/cognitum.v1.CalculateRationalResult";
+
+pub struct RationalCodec;
+fn valid_expression(expr: &str) -> bool {
+    !expr.is_empty()
+        && expr.len() <= 256
+        && expr.is_ascii()
+        && !["**", "//", "/*", "*/"].iter().any(|op| expr.contains(op))
+        && expr
+            .bytes()
+            .all(|b| b.is_ascii_digit() || b"+ -*/().".contains(&b))
+}
+impl ModelToolCodec for RationalCodec {
+    fn input_type_url(&self) -> &'static str {
+        INPUT
+    }
+    fn output_type_url(&self) -> &'static str {
+        OUTPUT
+    }
+    fn encode(&self, args: &Map<String, Value>) -> Result<ProtoPayload, ModelToolError> {
+        expect_fields(args, &["expression"], &["expression"])?;
+        let expression = args
+            .get("expression")
+            .and_then(Value::as_str)
+            .filter(|s| valid_expression(s))
+            .ok_or_else(|| {
+                ModelToolError::InvalidArguments("invalid bounded rational expression".into())
+            })?;
+        Ok(ProtoPayload {
+            type_url: INPUT.into(),
+            bytes: capability::CalculateRationalRequest {
+                expression: expression.into(),
+            }
+            .encode_to_vec(),
+        })
+    }
+    fn decode(&self, payload: &ProtoPayload) -> Result<Value, ModelToolError> {
+        if payload.type_url != OUTPUT {
+            return Err(ModelToolError::InvalidResult("type mismatch".into()));
+        }
+        let result = capability::CalculateRationalResult::decode(payload.bytes.as_slice())
+            .map_err(|_| ModelToolError::InvalidResult("bad result encoding".into()))?;
+        if result.encode_to_vec() != payload.bytes
+            || result.value.is_empty()
+            || result.value.len() > 128
+        {
+            return Err(ModelToolError::InvalidResult(
+                "noncanonical rational result".into(),
+            ));
+        }
+        Ok(
+            json!({"value":result.value,"mode":"experimental_unconfined_fixed_worker",
+            "luConversationAuthorized":true,"kernelConfined":false,"productionAdmission":false}),
+        )
+    }
+}
+
+struct WorkerTool {
+    descriptor: ToolDescriptor,
+    worker: CognitumDeveloperWorker,
+    cancellation: Cancellation,
+}
+impl NativeTool for WorkerTool {
+    fn descriptor(&self) -> &ToolDescriptor {
+        &self.descriptor
+    }
+    fn invoke(&self, call: ToolInvocation) -> ToolFuture<'_> {
+        let worker = self.worker.clone();
+        let cancellation = self.cancellation.clone();
+        Box::pin(async move {
+            // Reject noncanonical bytes before launching Python. Raw model
+            // arguments have already passed through the exact JSON->proto codec.
+            let input = capability::CalculateRationalRequest::decode(call.input.bytes.as_slice())
+                .map_err(|_| {
+                ToolFailure::new("BAD_PROTOBUF", "invalid rational request", false)
+            })?;
+            if input.encode_to_vec() != call.input.bytes || !valid_expression(&input.expression) {
+                return Err(ToolFailure::new(
+                    "INVALID_EXPRESSION",
+                    "rational expression denied",
+                    false,
+                ));
+            }
+            let worker_call_id = call.call_id.clone();
+            let computed = tokio::task::spawn_blocking(move || {
+                worker.run_rational_cancellable(&worker_call_id, &input.expression, &cancellation)
+            })
+            .await
+            .map_err(|_| ToolFailure::new("WORKER_FAILED", "Cognitum task stopped", true))?
+            .map_err(|_| {
+                ToolFailure::new("WORKER_DENIED", "Cognitum native worker failed", false)
+            })?;
+            // Evidence is based on the verified D01 worker reply and Lu's
+            // independent policy gate, not on model-provided assurances.
+            let result = capability::CalculateRationalResult {
+                value: computed.value,
+                evidence: vec![capability::EvidenceRef {
+                    kind: "computation".into(),
+                    r#ref: call.call_id,
+                }],
+                limitations: vec!["intent_not_verified".into(), "kernel_not_confined".into()],
+            };
+            Ok(ToolOutput {
+                payload: ProtoPayload {
+                    type_url: OUTPUT.into(),
+                    bytes: result.encode_to_vec(),
+                },
+            })
+        })
+    }
+}
+
+/// Host-only, NEVER call from discovery. No direct socket request may register
+/// or select a worker. Read worker configuration exclusively from the trusted
+/// developer process environment, as set before starting Lu.
+pub fn register_cognitum_model_tool(
+    registry: &NativeToolRegistry,
+    catalog: &mut ModelToolCatalog,
+    cancellation: Cancellation,
+) -> Result<(), String> {
+    if std::env::var("LU_COGNITUM_D03_ENABLE").ok().as_deref() != Some("1") {
+        return Err("D03 host opt-in absent".into());
+    }
+    let root = std::env::var_os("LU_COGNITUM_DEV_ROOT").ok_or("worker root not configured")?;
+    let python =
+        std::env::var_os("LU_COGNITUM_DEV_PYTHON").ok_or("worker Python not configured")?;
+    let hash =
+        std::env::var("LU_COGNITUM_DEV_WORKER_SHA256").map_err(|_| "worker hash not configured")?;
+    let bytes = hex::decode(hash).map_err(|_| "worker hash malformed")?;
+    let expected: [u8; 32] = bytes.try_into().map_err(|_| "worker hash malformed")?;
+    let worker = CognitumDeveloperWorker::new(Path::new(&root), Path::new(&python), expected)?;
+    install_pinned_model_tool(registry, catalog, cancellation, worker)
+}
+
+fn install_pinned_model_tool(
+    registry: &NativeToolRegistry,
+    catalog: &mut ModelToolCatalog,
+    cancellation: Cancellation,
+    worker: CognitumDeveloperWorker,
+) -> Result<(), String> {
+    let desc = ToolDescriptor {
+        id: ID.into(),
+        display_name: "Cognitum exact rational arithmetic (D03 lab)".into(),
+        effect: ToolEffect::ExecuteCode,
+        input_type_url: INPUT.into(),
+        output_type_url: OUTPUT.into(),
+    };
+    registry
+        .register(
+            ModuleManifest {
+                id: "lu.cognitum".into(),
+                display_name: "Cognitum D03 experimental".into(),
+                contract_version: CORE_CONTRACT_VERSION,
+                kind: ModuleKind::Core,
+                tools: vec![desc.clone()],
+                panels: vec![],
+                workflows: vec![],
+            },
+            vec![Arc::new(WorkerTool {
+                descriptor: desc,
+                worker,
+                cancellation,
+            })],
+        )
+        .map_err(|e| format!("Cognitum registry denied: {e:?}"))?;
+    catalog.insert(registry, ModelToolDefinition {name:MODEL_NAME.into(), native_tool_id:ID.into(),
+        description:"Compute an exact bounded rational expression using the host-approved Cognitum Python worker (experimental).".into(),
+        parameters:json!({"type":"object","properties":{"expression":{"type":"string","minLength":1,"maxLength":256}},
+            "required":["expression"],"additionalProperties":false}),
+        codec:Arc::new(RationalCodec)}).map_err(|e|format!("Cognitum model schema denied: {e:?}"))?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn exact_model_json_protobuf_round_trip() {
+        let codec = RationalCodec;
+        let args = serde_json::from_value::<Map<String, Value>>(json!({"expression":"1/3 + 1/6"}))
+            .unwrap();
+        let payload = codec.encode(&args).unwrap();
+        let d = capability::CalculateRationalRequest::decode(payload.bytes.as_slice()).unwrap();
+        assert_eq!(d.expression, "1/3 + 1/6");
+    }
+    #[test]
+    fn reject_path_injection_and_extra_arguments() {
+        let codec = RationalCodec;
+        for value in [
+            json!({"expression":"__import__('os')"}),
+            json!({"expression":"1/2","python_path":"/tmp/x"}),
+            json!({"expression":"2**10000"}),
+            json!({"expression":""}),
+            json!({"expression":true}),
+        ] {
+            let args = value.as_object().unwrap();
+            assert!(codec.encode(args).is_err());
+        }
+    }
+    // Integration: scripted model output -> normal Lu conversation authority
+    // -> typed registry -> real pinned Python worker -> model feedback.
+    // This tests actual model-shaped dispatch, not a model's autonomous choice.
+    #[tokio::test]
+    async fn real_worker_only_runs_through_bound_model_tool_authority() {
+        use crate::agent_tool_loop::{NativeToolTurn, ToolTurnError, ToolTurnOutcome};
+        use crate::conversation_authority::{
+            AuthorizedCapability, BoundCallOrigin, ConversationAuthority, TaskAuthority,
+            TrustedUserTurnVerifier,
+        };
+        use crate::policy::{CapabilityGrant, PolicyEngine};
+        use sha2::Digest;
+        use std::collections::BTreeSet;
+        struct Verifier;
+        impl TrustedUserTurnVerifier for Verifier {
+            fn verify_user_turn(&self, conversation_id: &str, user_turn_id: &str) -> bool {
+                conversation_id == "saved-conversation" && user_turn_id == "saved-user-turn"
+            }
+        }
+        let (Ok(root), Ok(python)) = (
+            std::env::var("COGNITUM_DEV_ROOT"),
+            std::env::var("COGNITUM_DEV_PYTHON"),
+        ) else {
+            return;
+        };
+        let source =
+            std::fs::read(Path::new(&root).join("cognitum/alpha_native_worker.py")).unwrap();
+        let sha: [u8; 32] = sha2::Sha256::digest(source).into();
+        let worker =
+            CognitumDeveloperWorker::new(Path::new(&root), Path::new(&python), sha).unwrap();
+        let registry = NativeToolRegistry::new();
+        let mut catalog = ModelToolCatalog::new();
+        install_pinned_model_tool(&registry, &mut catalog, Cancellation::default(), worker)
+            .unwrap();
+        let authority = ConversationAuthority::new();
+        let origin = BoundCallOrigin {
+            conversation_id: "saved-conversation".into(),
+            user_turn_id: "saved-user-turn".into(),
+            task_id: "host-task-01".into(),
+        };
+        let scope = "thread:saved-conversation".to_owned();
+        let grant = TaskAuthority {
+            conversation_id: origin.conversation_id.clone(),
+            user_turn_id: origin.user_turn_id.clone(),
+            task_id: origin.task_id.clone(),
+            execution_scope_id: scope.clone(),
+            capabilities: vec![AuthorizedCapability {
+                tool_id: ID.into(),
+                effect: ToolEffect::ExecuteCode,
+            }],
+            expires_at: None,
+        };
+        assert!(authority
+            .open_user_task(
+                TaskAuthority {
+                    user_turn_id: "forged-role".into(),
+                    ..grant.clone()
+                },
+                &Verifier
+            )
+            .is_err());
+        authority.open_user_task(grant, &Verifier).unwrap();
+        let allow = BTreeSet::from([MODEL_NAME.to_owned()]);
+        let mut turn =
+            NativeToolTurn::new(&catalog, &authority, origin.clone(), scope.clone(), &allow)
+                .unwrap();
+        let policy = PolicyEngine::new();
+        // Without separately issued host policy the model may request the
+        // function, but execution must be denied rather than launched.
+        let raw = r#"{"kind":"tool","name":"lu_cognitum_rational","arguments":{"expression":"1/3 + 1/6"}}"#;
+        let denied = turn
+            .handle_model_reply(raw, &catalog, &registry, &authority, &policy)
+            .await
+            .unwrap();
+        match denied {
+            ToolTurnOutcome::ToolResult { data, .. } => assert_eq!(data["ok"], false),
+            _ => panic!("expected denied result"),
+        }
+        policy
+            .grant(CapabilityGrant {
+                tool_id: ID.into(),
+                scope_id: scope.clone(),
+                effect: ToolEffect::ExecuteCode,
+                expires_at: None,
+            })
+            .unwrap();
+        let accepted = turn
+            .handle_model_reply(raw, &catalog, &registry, &authority, &policy)
+            .await
+            .unwrap();
+        match &accepted {
+            ToolTurnOutcome::ToolResult { data, .. } => {
+                assert_eq!(data["ok"], true);
+                assert_eq!(data["result"]["value"], "1/2");
+                assert_eq!(data["result"]["kernelConfined"], false);
+            }
+            _ => panic!("expected result"),
+        }
+        let feedback = NativeToolTurn::model_feedback(&accepted).unwrap();
+        assert!(feedback.contains("1/2"));
+        authority.revoke_task(&origin.task_id).unwrap();
+        let revoked = turn
+            .handle_model_reply(raw, &catalog, &registry, &authority, &policy)
+            .await;
+        assert!(matches!(
+            revoked,
+            Ok(ToolTurnOutcome::ToolResult { .. }) | Err(ToolTurnError::Unauthorized(_))
+        ));
+        // No second real execution is valid after revocation, even if a
+        // previous model-facing schema remains in memory.
+        if let Ok(ToolTurnOutcome::ToolResult { data, .. }) = revoked {
+            assert_eq!(data["ok"], false);
+        }
+    }
+
+    #[test]
+    fn never_accept_wrong_tool_result_type_or_noncanonical_payload() {
+        let codec = RationalCodec;
+        let malformed = ProtoPayload {
+            type_url: OUTPUT.into(),
+            bytes: vec![0xff],
+        };
+        assert!(codec.decode(&malformed).is_err());
+        let mut wrong = malformed;
+        wrong.type_url = "type.googleapis.com/other.Result".into();
+        assert!(codec.decode(&wrong).is_err());
+    }
+}
