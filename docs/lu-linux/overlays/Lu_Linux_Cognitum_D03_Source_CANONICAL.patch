@@ -0,0 +1,193 @@
+//! D03 local-operator approval journal, NOT a production CE permission store.
+//!
+//! Host-created records bind one persisted USER turn to one random Lu task
+//! identifier and the pinned fixed-worker source. Consumed transactionally
+//! once; replay and cross-turn substitution fail closed. Only the Linux
+//! test-host operator may issue. The model has no write API to this journal.
+use rusqlite::{params, Connection, OpenFlags, TransactionBehavior};
+use std::{
+    fs::{self, OpenOptions},
+    os::unix::fs::{OpenOptionsExt, PermissionsExt},
+    path::Path,
+    time::{SystemTime, UNIX_EPOCH},
+};
+
+const FILE: &str = "lu-cognitum-d03-approvals.sqlite3";
+const TTL_SECONDS: i64 = 300;
+fn now() -> Result<i64, String> {
+    Ok(SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|_| "clock invalid")?
+        .as_secs() as i64)
+}
+fn valid_id(id: &str) -> bool {
+    !id.is_empty() && id.len() <= 128 && !id.contains('\0')
+}
+fn valid_sha(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|x| x.is_ascii_hexdigit() && !x.is_ascii_uppercase())
+}
+
+pub struct DevApprovalStore {
+    conn: Connection,
+}
+impl DevApprovalStore {
+    pub fn open(folder: &Path) -> Result<Self, String> {
+        let meta = fs::symlink_metadata(folder).map_err(|_| "dev approval root missing")?;
+        if !meta.is_dir() || meta.file_type().is_symlink() || meta.permissions().mode() & 0o077 != 0
+        {
+            return Err("dev approval root not owner private".into());
+        }
+        let root = folder
+            .canonicalize()
+            .map_err(|_| "dev approval root not canonical")?;
+        let path = root.join(FILE);
+        match fs::symlink_metadata(&path) {
+            Ok(meta)
+                if !meta.is_file()
+                    || meta.file_type().is_symlink()
+                    || meta.permissions().mode() & 0o077 != 0 =>
+            {
+                return Err("dev approval journal not private file".into())
+            }
+            Ok(_) => {}
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
+                match OpenOptions::new()
+                    .write(true)
+                    .create_new(true)
+                    .mode(0o600)
+                    .open(&path)
+                {
+                    Ok(file) => drop(file),
+                    Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {}
+                    Err(_) => return Err("dev approval journal creation failed".into()),
+                }
+            }
+            Err(_) => return Err("dev approval journal inaccessible".into()),
+        }
+        let meta = fs::symlink_metadata(&path).map_err(|_| "dev approval journal missing")?;
+        if !meta.is_file()
+            || meta.file_type().is_symlink()
+            || meta.permissions().mode() & 0o077 != 0
+        {
+            return Err("dev approval journal not private".into());
+        }
+        let conn = Connection::open_with_flags(
+            path,
+            OpenFlags::SQLITE_OPEN_READ_WRITE | OpenFlags::SQLITE_OPEN_NO_MUTEX,
+        )
+        .map_err(|_| "dev approval journal unavailable")?;
+        conn.execute_batch(
+            "PRAGMA synchronous=FULL; PRAGMA journal_mode=DELETE;
+             CREATE TABLE IF NOT EXISTS approvals (
+               turn_id TEXT PRIMARY KEY NOT NULL,
+               conversation_id TEXT NOT NULL,
+               user_turn_id TEXT NOT NULL,
+               fixed_worker_sha TEXT NOT NULL,
+               approved_at INTEGER NOT NULL,
+               consumed INTEGER NOT NULL DEFAULT 0 CHECK(consumed IN (0,1))
+             );",
+        )
+        .map_err(|_| "dev approval schema unavailable")?;
+        Ok(Self { conn })
+    }
+    /// Only called after authenticated operator request + durable USER turn
+    /// creation; never exposed to a model schema or general UI command.
+    pub fn issue(
+        &mut self,
+        turn: &str,
+        conversation: &str,
+        user_turn: &str,
+        sha: &str,
+    ) -> Result<(), String> {
+        if !valid_id(turn) || !valid_id(conversation) || !valid_id(user_turn) || !valid_sha(sha) {
+            return Err("invalid approval identity".into());
+        }
+        self.conn.execute("INSERT INTO approvals(turn_id,conversation_id,user_turn_id,fixed_worker_sha,approved_at,consumed) VALUES (?1,?2,?3,?4,?5,0)",
+            params![turn,conversation,user_turn,sha,now()?]).map_err(|_|"duplicate or invalid developer approval")?;
+        Ok(())
+    }
+    /// Must be invoked only *after* the desktop has re-attested the saved
+    /// conversation and USER record, before schema advertisement or worker
+    /// registration. An absent/expired/replayed record denies the capability.
+    pub fn consume(
+        &mut self,
+        turn: &str,
+        conversation: &str,
+        user_turn: &str,
+        sha: &str,
+    ) -> Result<bool, String> {
+        if !valid_id(turn) || !valid_id(conversation) || !valid_id(user_turn) || !valid_sha(sha) {
+            return Err("invalid approval identity".into());
+        }
+        let tx = self
+            .conn
+            .transaction_with_behavior(TransactionBehavior::Immediate)
+            .map_err(|_| "approval lock unavailable")?;
+        let changed=tx.execute("UPDATE approvals SET consumed=1 WHERE turn_id=?1 AND conversation_id=?2
+            AND user_turn_id=?3 AND fixed_worker_sha=?4 AND consumed=0 AND approved_at BETWEEN ?5 AND ?6",
+            params![turn,conversation,user_turn,sha,now()?-TTL_SECONDS,now()?])
+            .map_err(|_|"approval consumption failure")?;
+        tx.commit().map_err(|_| "approval persistence failure")?;
+        Ok(changed == 1)
+    }
+}
