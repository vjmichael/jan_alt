+    fn d04_cleanup_kills_same_group_grandchild_even_after_parent_exits() {
+        // Synthetic negative control: the direct Python worker exits 0 but
+        // leaves a descendant that inherited its stdout. No Cognitum package
+        // is modified, and no claim is made about setsid breakaway children.
+        use std::fs;
+        use std::time::SystemTime;
+        let marker = std::env::temp_dir().join(format!(
+            "lu-d04-grandchild-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        let code = "import subprocess,sys; p=subprocess.Popen([sys.executable,'-c','import time;time.sleep(45)']);open(sys.argv[1],'w').write(str(p.pid))";
+        let mut child = Command::new("/usr/bin/python3")
+            .arg("-c")
+            .arg(code)
+            .arg(&marker)
+            .process_group(0)
+            .stdout(Stdio::piped())
+            .spawn()
+            .unwrap();
+        let deadline = Instant::now() + Duration::from_secs(4);
+        while !marker.exists() && Instant::now() < deadline {
+            thread::sleep(Duration::from_millis(10));
+        }
+        if !marker.exists() {
+            let _ = cleanup_worker_group(&mut child);
+            panic!("negative-control descendant did not start");
+        }
+        let descendant: u32 = fs::read_to_string(&marker).unwrap().parse().unwrap();
+        let _ = fs::remove_file(&marker);
+        // Parent has exited; killing its PID alone cannot kill the descendant.
+        let _ = child.wait().unwrap();
+        cleanup_worker_group(&mut child).unwrap();
+        let deadline = Instant::now() + Duration::from_secs(2);
+        loop {
+            let stat = fs::read_to_string(format!("/proc/{descendant}/stat"));
+            let alive = match stat {
+                Ok(s) => !s.split(") ").nth(1).unwrap_or("").starts_with('Z'),
+                Err(_) => false,
+            };
+            if !alive {
+                break;
+            }
+            if Instant::now() >= deadline {
+                panic!("same-group descendant survived SIGKILL");
+            }
+            thread::sleep(Duration::from_millis(10));
+        }
+    }
