+/// D04 Linux developer-only cleanup hardening. The direct child is always
+/// placed into its own process group. Killing just the Python PID is unsafe:
+/// grandchildren inheriting the worker pipes can outlive it. This cleanup
+/// reaches same-PGID descendants, but is NOT cgroup2 containment: a hostile
+/// descendant can escape via setsid/setpgid and a host crash can interrupt it.
+/// Call even on a successful worker return; do not leave idle descendants.
+fn cleanup_worker_group(child: &mut Child) -> Result<(), String> {
+    let pgid = rustix::process::Pid::from_child(child);
+    let signal = rustix::process::kill_process_group(pgid, rustix::process::Signal::KILL);
+    // ESRCH means the group is gone. Any other error is not evidence of cleanup.
+    let clean_signal = match signal {
+        Ok(()) | Err(rustix::io::Errno::SRCH) => Ok(()),
+        Err(e) => Err(format!("Cognitum process group cleanup failed: {e}")),
+    };
+    // In all cases reap the original child; never return a positive status
+    // merely because try_wait observed its exit before descendants were reaped.
+    let reaped = child
+        .wait()
+        .map_err(|e| format!("Cognitum direct worker reap failed: {e}"));
+    clean_signal?;
+    reaped?;
+    Ok(())
+}
